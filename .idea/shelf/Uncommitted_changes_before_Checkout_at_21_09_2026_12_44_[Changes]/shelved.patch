+package primeirobd.controller;
+
+import jakarta.servlet.ServletException;
+import jakarta.servlet.annotation.WebServlet;
+import jakarta.servlet.http.HttpServlet;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import primeirobd.DAO.*;
+import primeirobd.model.*;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+
+@WebServlet(name = "ServletGranjas", value = "/granjas")
+public class ServletGranjas extends HttpServlet {
+    @Override
+    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
+        GranjaDAO granja = new GranjaDAO();
+        granja.select();
+        List<Granja> granjas = new ArrayList<>();
+        request.setAttribute("granjas", granjas);
+        getServletContext().getRequestDispatcher("/granjas.jsp").forward(request, response);
+    }
+
+    @Override
+    protected void doPost(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {
+
+    }
+}
